  <!-- Section 4: 4 Value Pillars -->
  <section class="section-wrap" style="padding-top: 10px; padding-bottom: 20px;">
    <div class="pillars-grid">
      <div class="pillar-card">
        <div class="pillar-icon-disc">🍲</div>
        <h4 class="pillar-title">Freshly Made</h4>
        <p class="pillar-sub">Prepared fresh, everytime.</p>
      </div>
      <div class="pillar-card">
        <div class="pillar-icon-disc">🥑</div>
        <h4 class="pillar-title">Quality Ingredients</h4>
        <p class="pillar-sub">Only the best, always.</p>
      </div>
      <div class="pillar-card">
        <div class="pillar-icon-disc">👥</div>
        <h4 class="pillar-title">Great Ambience</h4>
        <p class="pillar-sub">A place to hangout & enjoy.</p>
      </div>
      <div class="pillar-card">
        <div class="pillar-icon-disc">💚</div>
        <h4 class="pillar-title">Food for Everyone</h4>
        <p class="pillar-sub">Angus, chicken, crispy & more.</p>
      </div>
    </div>
  </section>

  <!-- Section 5: Our Story (Restaurant Photo + Philosophy) -->
  <section class="section-wrap" id="story">
    <div class="story-grid">
