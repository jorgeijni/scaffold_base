            <span class="stat-label">Tiempo Promedio</span>
          </div>
          <div class="hero-stat-item">
            <span class="stat-num">100%</span>
            <span class="stat-label">Angus Certificado</span>
          </div>
          <div class="hero-stat-item">
            <span class="stat-num">4.9 / 5</span>
            <span class="stat-label">15,000+ Clientes</span>
          </div>
          <div class="hero-stat-item">
            <span class="stat-num">10</span>
            <span class="stat-label">Recetas de Autor</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Card -->
      <div class="hero-visual">
        <div class="hero-card-featured">
          <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=800&auto=format&fit=crop&q=80" alt="Rey de las Burgers" />
          <div class="hero-card-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="background: #fef3c7; color: #92400e; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 9999px; border: 1px solid #fde68a;">
                👑 SIGNATURE MASTER
              </span>
              <span style="font-size: 1.4rem; font-weight: 800; color: #b45309;">$15.90</span>
            </div>
            <h3 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-bottom: 0.4rem;">Rey de las Burgers</h3>
            <p style="font-size: 0.88rem; color: #64748b;">Nuestra hamburguesa insignia con doble carne Angus, queso cheddar 12 meses y cebolla al bourbon.</p>
          </div>
        </div>

        <div class="floating-delivery-badge">
          <div class="pulse-dot"></div>
          <div>
            <div style="font-size: 0.85rem; font-weight: 800; color: #0f172a;">Entregas en Vivo PWA</div>
            <div style="font-size: 0.72rem; color: #64748b;">Simulación en tiempo real &bull; 20 min</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Strip -->
  <section class="features-strip" id="experiencia">
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon-box">🥩</div>
        <div class="feature-info">
          <h4>Carne 100% Angus</h4>
          <p>Cortes madurados 28 días sin congelar, cocinados al punto exacto a la parrilla de roble.</p>
        </div>
      </div>
      <div class="feature-card">
        <div class="feature-icon-box">🥖</div>
