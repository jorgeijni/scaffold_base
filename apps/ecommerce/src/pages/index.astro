              </div>
              <h3 class="bestseller-title">{b.name}</h3>
              <p class="bestseller-desc">{b.description}</p>
            </div>

            <div class="bestseller-footer">
              <span class="bestseller-price">${b.price.toFixed(2)}</span>
              <div style="display: flex; gap: 6px;">
                <button
                  class="btn-outline-pill open-modal-btn"
                  style="padding: 5px 12px; font-size: 0.75rem; border-color: #d1d5db; color: #111111;"
                  data-burger={JSON.stringify(b)}
                >
                  Detalles
                </button>
                <a href="/app" class="btn-add-mini">
                  Pedir +
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 7: What Our Customers Say (Testimonials) -->
  <section class="section-wrap">
    <div class="section-header-row">
      <div>
        <div class="section-eyebrow">REAL PEOPLE. REAL BURGERS.</div>
        <h2 class="section-title">What Our Customers Say</h2>
      </div>
      <div style="display: flex; gap: 8px;">
        <button class="btn-outline-pill" style="padding: 6px 14px; border-color: #d1d5db; color: #111111;">←</button>
        <button class="btn-gold-pill" style="padding: 6px 14px;">→</button>
      </div>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((t) => (
        <div class="testimonial-card">
          <p class="testimonial-quote">"{t.quote}"</p>
          <div class="testimonial-user">
            <div class="testimonial-avatar-info">
              <img src={t.avatar} alt={t.name} class="testimonial-avatar" />
              <span class="testimonial-name">{t.name}</span>
            </div>
            <div class="testimonial-stars">★★★★★</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Newsletter Bar -->
    <div class="newsletter-banner">
      <div>
        <h3 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 4px;">Get Exclusive Offers & Updates</h3>
        <p style="color: #9ca3af; font-size: 0.88rem;">Join our foodie community and never miss a delicious deal.</p>
      </div>

      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('¡Gracias por suscribirte a Burger Bros!');">
        <input type="email" placeholder="Enter your email address..." class="newsletter-input" required />
        <button type="submit" class="btn-subscribe">Subscribe ➔</button>
