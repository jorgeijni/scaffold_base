      <button class="filter-tab-btn" data-filter="pollo">Pollo Crispy</button>
    </div>

    <!-- 10 Burgers Grid -->
    <div class="catalogo-grid">
      {burgers.map((b) => (
        <div class="bestseller-card" data-category={b.category}>
          <div class="bestseller-img-box">
            <img src={b.image} alt={b.name} loading="lazy" />
            <span class="bestseller-badge" style="background: #111111; color: var(--gold);">
              {b.specialtyBadge}
            </span>
          </div>

          <div class="bestseller-body">
            <div>
