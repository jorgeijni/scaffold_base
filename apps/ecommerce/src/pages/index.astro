<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Oswald:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0a0e17;
      --bg-card: #121824;
      --bg-card-alt: #172033;
      --border-color: #1f2a3e;
      --text-white: #f8fafc;
      --text-muted: #94a3b8;
      --gold: #f59e0b;
      --gold-hover: #d97706;
      --accent-orange: #f97316;
      --primary: #2563eb;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-white);
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* Top Announcement Bar */
    .top-banner {
      background: linear-gradient(90deg, #b45309, #d97706, #b45309);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      text-align: center;
      padding: 6px 16px;
      letter-spacing: 0.05em;
    }

    /* Navigation */
    .navbar {
      background: rgba(10, 14, 23, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 14px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #fff;
    }
    .brand-icon {
      font-size: 1.8rem;
    }
    .brand-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.5rem;
      letter-spacing: 0.02em;
      color: #fff;
    }
    .brand-tag {
      font-size: 0.68rem;
      color: var(--gold);
      letter-spacing: 0.1em;
      display: block;
    }
    .nav-links {
      display: flex;
      gap: 24px;
      list-style: none;
      align-items: center;
    }
    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      transition: color 0.2s;
    }
    .nav-links a:hover, .nav-links a.active {
      color: var(--gold);
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .btn-cart {
      background: #172033;
      border: 1px solid var(--border-color);
      color: var(--gold);
      padding: 8px 14px;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }
    .btn-admin {
      background: var(--gold);
      color: #000;
      padding: 8px 16px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.85rem;
      text-decoration: none;
      transition: background 0.2s;
    }
    .btn-admin:hover {
      background: var(--gold-hover);
    }

    /* Hero Section */
    .hero {
      padding: 60px 32px 50px;
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 40px;
    }
    .hero-tag {
      color: var(--gold);
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .hero h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 4rem;
      line-height: 1.05;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 16px;
      text-transform: uppercase;
    }
    .hero h1 span {
      color: var(--gold);
    }
    .hero p {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 28px;
      max-width: 520px;
    }
    .hero-cta {
      display: flex;
      gap: 14px;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .btn-primary {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #0b0f19;
      font-weight: 800;
      padding: 14px 28px;
      border-radius: 10px;
      text-decoration: none;
      font-size: 0.95rem;
      box-shadow: 0 10px 25px rgba(245, 158, 11, 0.35);
      transition: transform 0.2s, box-shadow 0.2s;
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 30px rgba(245, 158, 11, 0.5);
    }
    .btn-secondary {
      background: #172033;
      border: 1px solid var(--border-color);
      color: #fff;
      font-weight: 700;
      padding: 14px 24px;
      border-radius: 10px;
      text-decoration: none;
      font-size: 0.95rem;
      transition: background 0.2s;
    }
    .btn-secondary:hover {
      background: #1f2a3e;
    }
    .hero-rating {
      font-size: 0.85rem;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .hero-rating span {
      color: var(--gold);
    }
    .hero-image-wrap {
      position: relative;
      text-align: center;
    }
    .hero-image {
      width: 100%;
      max-width: 480px;
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8), 0 0 60px rgba(245, 158, 11, 0.15);
      border: 1px solid var(--border-color);
    }
    .hero-floating-badge {
      position: absolute;
      bottom: -15px;
      right: 20px;
      background: rgba(10, 14, 23, 0.9);
      border: 1px solid var(--gold);
      padding: 10px 18px;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Quality Highlights Bar */
    .quality-bar {
      background: #0d1320;
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
      padding: 24px 32px;
    }
    .quality-grid {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }
    .quality-item {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .quality-icon {
      font-size: 1.8rem;
    }
    .quality-title {
      font-weight: 800;
      font-size: 0.85rem;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .quality-desc {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    /* Section Styles */
    .section {
      max-width: 1240px;
      margin: 0 auto;
      padding: 60px 32px;
    }
    .section-header {
      text-align: left;
      margin-bottom: 36px;
    }
    .section-subtitle {
      color: var(--gold);
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 6px;
    }
    .section-title {
      font-family: 'Oswald', sans-serif;
      font-size: 2.4rem;
      text-transform: uppercase;
      letter-spacing: -0.01em;
    }
    .section-desc {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-top: 4px;
    }

    /* Categories Circular */
    .categories-row {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      padding-bottom: 16px;
      margin-bottom: 50px;
    }
    .category-circle-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      min-width: 90px;
      text-decoration: none;
      color: var(--text-muted);
      transition: transform 0.2s;
    }
    .category-circle-item:hover {
      transform: translateY(-4px);
      color: var(--gold);
    }
    .category-circle {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
    .category-name {
      font-size: 0.78rem;
      font-weight: 700;
      text-align: center;
    }

    /* 10 Variants Catalog Grid */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }
    .burger-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-6px);
      border-color: rgba(245, 158, 11, 0.4);
      box-shadow: 0 20px 30px -10px rgba(0,0,0,0.6);
    }
    .card-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(10, 14, 23, 0.85);
      border: 1px solid var(--gold);
      color: var(--gold);
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 0.72rem;
      font-weight: 800;
      backdrop-filter: blur(4px);
      z-index: 2;
    }
    .card-img-wrap {
      width: 100%;
      height: 200px;
      overflow: hidden;
      background: #000;
    }
    .card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s;
    }
    .burger-card:hover .card-img {
      transform: scale(1.06);
    }
    .card-body {
      padding: 18px 20px 20px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-meta {
      display: flex;
      justify-content: space-between;
      color: var(--text-muted);
      font-size: 0.75rem;
      margin-bottom: 6px;
    }
    .card-title {
      font-size: 1.15rem;
      font-weight: 800;
      margin-bottom: 8px;
      color: #fff;
    }
    .card-desc {
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.5;
      margin-bottom: 16px;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border-color);
      padding-top: 14px;
      margin-top: auto;
    }
    .card-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--gold);
    }
    .card-actions {
      display: flex;
      gap: 8px;
    }
    .btn-detail {
      background: #172033;
      border: 1px solid var(--border-color);
      color: #cbd5e1;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-detail:hover {
      background: #1f2a3e;
      color: #fff;
    }
    .btn-add {
      background: var(--gold);
      color: #0b0f19;
      border: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 800;
      cursor: pointer;
      transition: background 0.2s;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .btn-add:hover {
      background: var(--gold-hover);
    }

    /* Popular Sides Grid */
    .sides-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-bottom: 60px;
    }
    .side-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .side-img {
      width: 100%;
      height: 150px;
      object-fit: cover;
    }
    .side-body {
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    /* Combo Banner (Make it a meal) */
    .meal-banner {
      background: linear-gradient(90deg, #d97706 0%, #f59e0b 50%, #d97706 100%);
      color: #0b0f19;
      border-radius: 20px;
      padding: 36px 44px;
      margin: 40px auto 60px;
      max-width: 1240px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 30px;
      box-shadow: 0 20px 40px rgba(245, 158, 11, 0.25);
    }
    .meal-banner h2 {
      font-family: 'Oswald', sans-serif;
      font-size: 2.8rem;
      line-height: 1.1;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 10px;
    }
    .meal-banner p {
      font-size: 1.05rem;
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 20px;
    }

    /* 3-Layer Integration Box */
    .integration-box {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 20px;
      padding: 36px;
      max-width: 1240px;
      margin: 0 auto 60px;
      text-align: center;
    }
    .integration-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 24px;
      text-align: left;
    }
    .integration-card {
      background: #172033;
      border: 1px solid #26334d;
      padding: 24px;
      border-radius: 14px;
      text-decoration: none;
      color: #fff;
      display: block;
      transition: transform 0.2s, border-color 0.2s;
    }
    .integration-card:hover {
      transform: translateY(-4px);
      border-color: var(--gold);
    }

    /* Testimonials */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 24px;
    }
    .testimonial-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 24px;
      border-radius: 14px;
    }
    .testimonial-stars {
      color: var(--gold);
      margin-bottom: 12px;
    }
    .testimonial-text {
      color: var(--text-muted);
      font-size: 0.88rem;
