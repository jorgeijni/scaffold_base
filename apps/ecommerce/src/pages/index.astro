    </div>
  </section>

  <!-- Main Footer -->
  <footer class="main-footer">
    <div class="footer-container">
      <div>
        <div class="footer-brand">
          BURGER <span style="color: var(--gold);">BROS</span>
        </div>
        <p style="font-size: 0.85rem; line-height: 1.6; max-width: 280px; margin-bottom: 18px;">
          Plataforma gourmet oficial de hamburguesas a la leña, combos express y tecnología de entrega rápida en 20 minutos.
        </p>
        <div style="display: flex; gap: 10px; font-size: 1.2rem;">
          <span>📸</span> <span>📘</span> <span>🐦</span> <span>▶️</span>
        </div>
      </div>

      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="#catalogo">Catálogo Completo</a></li>
          <li><a href="#story">Nuestra Historia</a></li>
          <li><a href="#combos">Combos & Ofertas</a></li>
          <li><a href="/app">📱 App Móvil PWA</a></li>
          <li><a href="/admin">⚙️ Panel Admin</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Support & Horarios</h4>
        <ul>
          <li>Lunes a Domingo: 11:30 - 23:30</li>
          <li>Entrega garantizada &lt; 20 min</li>
          <li>Soporte: ayuda@burgerbros.com</li>
          <li>Preguntas Frecuentes</li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Visit Us</h4>
        <ul>
          <li>Av. Las Condes #1240, Santiago</li>
          <li>Central Gourmet Rapid &bull; Dokploy</li>
          <li>Teléfono: +56 9 8765 4321</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>&copy; 2026 BURGER BROS &bull; Hamburger Rapid Platform. Todos los derechos reservados.</div>
      <div>Referencia visual: <code>assets-reference/8eb525b24347c5095bab08ef1a375031.jpg</code></div>
    </div>
