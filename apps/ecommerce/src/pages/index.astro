        <div class="hero-trust-bar">
          <div class="trust-item">
            <span class="icon">🌿</span>
            <span>Fresh Ingredients</span>
          </div>
          <div class="trust-item">
            <span class="icon">🥩</span>
            <span>100% Angus Certified</span>
          </div>
          <div class="trust-item">
            <span class="icon">❤️</span>
            <span>15,000+ Foodies</span>
          </div>
          <div class="trust-item">
            <span class="icon">⭐</span>
            <span>4.9/5 Rating</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual with Food and Handwritten Note -->
      <div class="hero-visual">
        <div class="hero-handwritten-note">
          Bigger<br />Burgers<br />Brighter<br />Days ⤵
        </div>
        <img
          src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=800&auto=format&fit=crop&q=80"
          alt="Burger Bros Gourmet Burger"
          class="hero-food-composite"
        />
      </div>
    </div>
  </section>

  <!-- Section 1: Something for Every Craving (Category Circles) -->
  <section class="section-wrap">
    <div class="section-header-row">
      <div>
        <div class="section-eyebrow">EXPLORE OUR MENU</div>
        <h2 class="section-title">Something for Every Craving</h2>
      </div>
      <a href="#catalogo" class="section-link">
        View Full Menu ➔
      </a>
    </div>

    <div class="categories-grid">
      {categories.map((cat) => (
        <a href="#catalogo" class="category-circle-item">
          <div class="category-img-disc">
            <img src={cat.image} alt={cat.name} loading="lazy" />
          </div>
          <span class="category-label">{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 2: Our Bestsellers -->
  <section class="section-wrap" style="padding-top: 0;">
    <div class="section-header-row">
      <div>
        <div class="section-eyebrow">CUSTOMER FAVOURITES</div>
        <h2 class="section-title">Our Bestsellers</h2>
      </div>
      <div style="display: flex; gap: 8px;">
