<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BURGER BROS &bull; Burgers That Bring People Together | Hamburger Rapid</title>
  <meta name="description" content="Burger Bros: Juicy burgers, crispy fries and unforgettable flavours made with love and served fresh. Plataforma comercial unificada Hamburger Rapid." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Bebas+Neue&family=Caveat:wght@700&display=swap" rel="stylesheet">

  <style>
    /* =========================================================
       BURGER BROS DESIGN SYSTEM
       Fiel a assets-reference/8eb525b24347c5095bab08ef1a375031.jpg
       Paleta: Dark Dramatic Hero + Golden Amber Buttons (#E5A93C)
       ========================================================= */
    :root {
      --gold: #e5a93c;
      --gold-hover: #d49528;
      --gold-light: #fef5e7;
      --dark-bg: #0d0d0d;
      --dark-card: #151515;
      --dark-surface: #1f1f1f;
      --dark-border: #2c2c2c;
      --light-bg: #ffffff;
      --light-alt: #faf9f6;
      --light-card: #ffffff;
      --light-border: #f0ebe4;
      --coral-red: #d32f2f;
      --text-dark: #111111;
      --text-muted: #6b7280;
      --text-light-muted: #9ca3af;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.05);
      --shadow-hover: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--light-bg);
      color: var(--text-dark);
      line-height: 1.5;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    a {
      text-decoration: none;
      color: inherit;
      transition: all 0.2s ease;
    }

    /* -------------------------------------------------------------
       1. TOP PROMO BANNER (Yellow Announcement Bar)
       ------------------------------------------------------------- */
    .top-announcement {
      background: var(--gold);
      color: #111111;
      text-align: center;
      padding: 7px 16px;
      font-size: 0.85rem;
      font-weight: 700;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      position: relative;
    }
    .top-announcement a {
      background: #111111;
      color: #ffffff;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 800;
      margin-left: 6px;
    }
    .top-announcement a:hover {
      background: #333333;
    }

    /* -------------------------------------------------------------
       2. MAIN NAVBAR (Dark sleek header)
       ------------------------------------------------------------- */
    .main-nav {
      background: var(--dark-bg);
      border-bottom: 1px solid var(--dark-border);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .nav-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #ffffff;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.85rem;
      letter-spacing: 0.04em;
    }
    .brand-logo span.highlight {
      color: var(--gold);
    }
    .logo-badge {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .nav-item {
      color: #d1d5db;
      font-size: 0.88rem;
      font-weight: 600;
      position: relative;
      padding: 6px 0;
    }
    .nav-item:hover, .nav-item.active {
      color: #ffffff;
    }
    .nav-item.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 2.5px;
      background: var(--gold);
      border-radius: 2px;
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .nav-icon-btn {
      color: #ffffff;
      font-size: 1.15rem;
      cursor: pointer;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .nav-cart-badge {
      position: absolute;
      top: -6px;
      right: -8px;
      background: var(--gold);
      color: #111111;
      font-size: 0.65rem;
      font-weight: 800;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .btn-gold-pill {
      background: var(--gold);
      color: #111111;
      padding: 9px 20px;
      border-radius: var(--radius-full);
      font-weight: 800;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(229, 169, 60, 0.35);
    }
    .btn-gold-pill:hover {
      background: var(--gold-hover);
      transform: translateY(-1px);
    }

    /* -------------------------------------------------------------
       3. HERO SECTION (Dark Dramatic Banner with Burger & Fries)
       ------------------------------------------------------------- */
    .hero-section {
      background: var(--dark-bg);
      color: #ffffff;
      padding: 60px 24px 80px;
      position: relative;
      overflow: hidden;
    }
    .hero-container {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 40px;
    }
    .hero-eyebrow {
      font-size: 0.82rem;
      font-weight: 700;
      color: #9ca3af;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .hero-heading {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 4.8rem;
      line-height: 0.95;
      letter-spacing: 0.02em;
      margin-bottom: 18px;
    }
    .hero-heading span.gold {
      color: var(--gold);
    }
    .hero-desc {
      font-size: 1.05rem;
      color: #d1d5db;
      margin-bottom: 30px;
      max-width: 460px;
      line-height: 1.5;
    }
    .hero-cta-group {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 42px;
      flex-wrap: wrap;
    }
    .btn-outline-pill {
      background: transparent;
      color: #ffffff;
      border: 1.5px solid #4b5563;
      padding: 9px 22px;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
    }
    .btn-outline-pill:hover {
      border-color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
    }
    .hero-trust-bar {
      display: flex;
      gap: 20px;
      padding-top: 24px;
      border-top: 1px solid #262626;
      flex-wrap: wrap;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      color: #9ca3af;
      font-weight: 600;
    }
    .trust-item span.icon {
      font-size: 1.15rem;
      color: var(--gold);
    }
    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .hero-handwritten-note {
      position: absolute;
      top: -15px;
      left: 10px;
      font-family: 'Caveat', cursive;
      font-size: 2.1rem;
      color: #ffffff;
      line-height: 1;
      text-shadow: 0 4px 12px rgba(0,0,0,0.6);
      z-index: 5;
    }
    .hero-food-composite {
      width: 100%;
      max-width: 520px;
      border-radius: 24px;
      filter: drop-shadow(0 20px 40px rgba(0,0,0,0.8));
      object-fit: cover;
    }

    /* -------------------------------------------------------------
       4. CATEGORIES SECTION ("Something for Every Craving")
       ------------------------------------------------------------- */
    .section-wrap {
      max-width: 1240px;
      margin: 0 auto;
      padding: 70px 24px;
    }
    .section-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 34px;
    }
    .section-eyebrow {
      color: var(--coral-red);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .section-title {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--text-dark);
      letter-spacing: -0.02em;
    }
    .section-link {
      color: #111111;
      font-weight: 800;
      font-size: 0.88rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .section-link:hover {
      color: var(--gold);
    }
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 16px;
      text-align: center;
    }
    .category-circle-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }
    .category-img-disc {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      overflow: hidden;
      background: var(--light-alt);
      border: 2px solid var(--light-border);
      box-shadow: var(--shadow-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.25s ease;
    }
    .category-img-disc img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.25s ease;
    }
    .category-circle-item:hover .category-img-disc {
      border-color: var(--gold);
      transform: translateY(-4px);
      box-shadow: 0 10px 20px rgba(229, 169, 60, 0.2);
    }
    .category-circle-item:hover .category-img-disc img {
      transform: scale(1.08);
    }
    .category-label {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-dark);
    }

    /* -------------------------------------------------------------
       5. BESTSELLERS SECTION ("Our Bestsellers")
       ------------------------------------------------------------- */
    .bestsellers-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .bestseller-card {
      background: #ffffff;
      border-radius: var(--radius-lg);
      border: 1px solid var(--light-border);
      overflow: hidden;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
      position: relative;
    }
    .bestseller-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
      border-color: var(--gold);
    }
    .bestseller-img-box {
      width: 100%;
      height: 180px;
      background: #fbf7f2;
      overflow: hidden;
      position: relative;
    }
    .bestseller-img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
    .bestseller-card:hover .bestseller-img-box img {
      transform: scale(1.05);
    }
    .bestseller-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      background: var(--coral-red);
      color: #ffffff;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 6px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .bestseller-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
    }
    .bestseller-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-dark);
      margin-bottom: 4px;
    }
    .bestseller-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 14px;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .bestseller-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 10px;
      border-top: 1px solid #f3ede4;
    }
    .bestseller-price {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text-dark);
    }
    .btn-add-mini {
      background: var(--gold);
      color: #111111;
      font-size: 0.8rem;
      font-weight: 800;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .btn-add-mini:hover {
      background: var(--gold-hover);
    }

    /* -------------------------------------------------------------
       6. FEATURE SPLIT BANNERS (Combo it Better & Sweet Endings)
       ------------------------------------------------------------- */
    .feature-split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .feature-card-dark {
      background: var(--dark-bg);
      border-radius: 24px;
      padding: 36px 32px;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }
    .feature-card-light {
      background: #faf4ec;
      border: 1px solid #f3e5d3;
      border-radius: 24px;
      padding: 36px 32px;
      color: var(--text-dark);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }
    .feature-badge-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 3rem;
      line-height: 0.95;
      margin-bottom: 8px;
    }
    .feature-badge-title span.gold {
      color: var(--gold);
    }
    .feature-card-desc {
      font-size: 0.9rem;
      margin-bottom: 22px;
      max-width: 220px;
      line-height: 1.4;
    }
    .feature-img-right {
      width: 200px;
      height: 190px;
      object-fit: contain;
      filter: drop-shadow(0 14px 20px rgba(0,0,0,0.25));
    }
    .handwritten-sticker {
      position: absolute;
      top: 14px;
      right: 24px;
      font-family: 'Caveat', cursive;
      font-size: 1.6rem;
      color: #111111;
      transform: rotate(4deg);
    }

    /* -------------------------------------------------------------
       7. VALUE PILLARS (4 Features)
       ------------------------------------------------------------- */
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      text-align: center;
      padding: 40px 0;
    }
    .pillar-card {
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .pillar-icon-disc {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: var(--gold-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin-bottom: 4px;
    }
    .pillar-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text-dark);
    }
    .pillar-sub {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* -------------------------------------------------------------
       8. OUR STORY (Split section)
       ------------------------------------------------------------- */
    .story-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .story-image-box {
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 36px rgba(0,0,0,0.12);
      position: relative;
    }
    .story-image-box img {
      width: 100%;
      height: 380px;
      object-fit: cover;
      display: block;
    }
    .story-neon-tag {
      position: absolute;
      bottom: 20px;
      left: 20px;
      background: rgba(13, 13, 13, 0.85);
      backdrop-filter: blur(8px);
      padding: 12px 18px;
      border-radius: 14px;
      color: var(--gold);
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.05em;
    }
    .story-content {
      position: relative;
    }
    .story-handwritten {
      font-family: 'Caveat', cursive;
      font-size: 2rem;
      color: #6b7280;
      margin-top: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* -------------------------------------------------------------
       9. FULL CATALOGUE WITH MODAL
       ------------------------------------------------------------- */
    .catalogo-section {
      background: var(--light-alt);
      border-top: 1px solid var(--light-border);
      border-bottom: 1px solid var(--light-border);
      padding: 70px 24px;
    }
    .filter-tabs-row {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 36px;
      flex-wrap: wrap;
    }
    .filter-tab-btn {
      padding: 8px 20px;
      border-radius: var(--radius-full);
      background: #ffffff;
      border: 1px solid #e5e7eb;
      color: #4b5563;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .filter-tab-btn.active, .filter-tab-btn:hover {
      background: #111111;
      color: #ffffff;
      border-color: #111111;
    }
    .catalogo-grid {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
      gap: 22px;
    }

    /* -------------------------------------------------------------
       10. TESTIMONIALS
       ------------------------------------------------------------- */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    .testimonial-card {
      background: #ffffff;
      border-radius: var(--radius-lg);
      border: 1px solid var(--light-border);
      padding: 24px;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .testimonial-quote {
      font-size: 0.92rem;
      color: #374151;
      line-height: 1.5;
      margin-bottom: 18px;
      font-style: italic;
    }
    .testimonial-user {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .testimonial-avatar-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .testimonial-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
    }
    .testimonial-name {
      font-weight: 800;
      font-size: 0.9rem;
      color: var(--text-dark);
    }
    .testimonial-stars {
      color: #f59e0b;
      font-size: 0.9rem;
    }

    /* -------------------------------------------------------------
       11. NEWSLETTER PROMO BANNER (Dark)
       ------------------------------------------------------------- */
    .newsletter-banner {
      background: var(--dark-bg);
      border-radius: 28px;
      padding: 38px 48px;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      margin-top: 40px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.2);
    }
    .newsletter-form {
      display: flex;
      align-items: center;
      background: #ffffff;
      border-radius: var(--radius-full);
      padding: 4px;
      width: 100%;
      max-width: 420px;
    }
    .newsletter-input {
      flex: 1;
      border: none;
      outline: none;
      padding: 10px 16px;
      font-size: 0.88rem;
      background: transparent;
      color: #111111;
    }
    .btn-subscribe {
      background: var(--gold);
      color: #111111;
      padding: 10px 22px;
      border-radius: var(--radius-full);
      font-weight: 800;
      font-size: 0.85rem;
      border: none;
      cursor: pointer;
    }
    .btn-subscribe:hover {
      background: var(--gold-hover);
    }

    /* -------------------------------------------------------------
       12. FOOTER (Dark)
       ------------------------------------------------------------- */
    .main-footer {
      background: #080808;
      color: #9ca3af;
      padding: 60px 24px 30px;
      border-top: 1px solid #1a1a1a;
    }
    .footer-container {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }
    .footer-brand {
      color: #ffffff;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.8rem;
      margin-bottom: 12px;
    }
    .footer-col h4 {
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 800;
      margin-bottom: 16px;
    }
    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 0.85rem;
    }
    .footer-col ul li a:hover {
      color: var(--gold);
    }
    .footer-bottom {
      max-width: 1240px;
      margin: 0 auto;
      padding-top: 24px;
      border-top: 1px solid #1a1a1a;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
    }

    /* -------------------------------------------------------------
       13. MODAL DE INGREDIENTES Y DETALLES
       ------------------------------------------------------------- */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(13, 13, 13, 0.75);
      backdrop-filter: blur(6px);
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-box {
      background: #ffffff;
      border-radius: 24px;
      max-width: 620px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 25px 50px rgba(0,0,0,0.3);
      position: relative;
      animation: modalFadeIn 0.25s ease-out;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: translateY(20px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .modal-close-btn {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(0,0,0,0.6);
      color: #ffffff;
      border: none;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .categories-grid { grid-template-columns: repeat(4, 1fr); }
      .bestsellers-grid { grid-template-columns: repeat(2, 1fr); }
      .feature-split-grid { grid-template-columns: 1fr; }
      .story-grid { grid-template-columns: 1fr; }
      .hero-heading { font-size: 3.8rem; }
    }
    @media (max-width: 768px) {
      .hero-container { grid-template-columns: 1fr; }
      .nav-menu { display: none; }
      .categories-grid { grid-template-columns: repeat(3, 1fr); }
      .bestsellers-grid { grid-template-columns: 1fr; }
      .pillars-grid { grid-template-columns: repeat(2, 1fr); }
      .testimonials-grid { grid-template-columns: 1fr; }
      .newsletter-banner { flex-direction: column; text-align: center; }
      .footer-container { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

