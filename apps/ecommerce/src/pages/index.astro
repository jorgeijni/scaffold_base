  <!-- Script Interactivo para Filtros y Modal de Detalles -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Filtros de categoría
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.burger-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const filter = btn.getAttribute('data-filter');
          cards.forEach(card => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // 2. Modal "Ver Detalles"
      const modal = document.getElementById('burgerModal');
      const closeModalBtn = document.getElementById('closeModal');
      const modalCloseAction = document.getElementById('modalCloseAction');
      const detailButtons = document.querySelectorAll('.btn-details');

      const modalImg = document.getElementById('modalImg');
      const modalTitle = document.getElementById('modalTitle');
      const modalPrice = document.getElementById('modalPrice');
      const modalSpecialty = document.getElementById('modalSpecialty');
      const modalDesc = document.getElementById('modalDesc');
      const modalCalories = document.getElementById('modalCalories');
      const modalProtein = document.getElementById('modalProtein');
      const modalPrepTime = document.getElementById('modalPrepTime');
      const modalAllergens = document.getElementById('modalAllergens');
      const modalIngredients = document.getElementById('modalIngredients');

      detailButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const raw = btn.getAttribute('data-burger');
          if (!raw) return;
          const data = JSON.parse(raw);

          modalImg.src = data.image;
          modalImg.alt = data.name;
          modalTitle.textContent = data.name;
          modalPrice.textContent = `$${data.price.toFixed(2)}`;
          modalSpecialty.textContent = `${data.specialtyBadge} - ${data.specialtyLevel}`;
          modalDesc.textContent = data.description;
          modalCalories.textContent = data.calories;
          modalProtein.textContent = data.protein;
          modalPrepTime.textContent = data.prepTime;
          modalAllergens.textContent = data.allergens;

          // Ingredientes
          modalIngredients.innerHTML = '';
          if (Array.isArray(data.ingredients)) {
            data.ingredients.forEach(item => {
              const li = document.createElement('li');
              li.textContent = item;
              modalIngredients.appendChild(li);
            });
          }

          modal.classList.add('open');
        });
      });

      const closeModal = () => modal.classList.remove('open');
      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (modalCloseAction) modalCloseAction.addEventListener('click', closeModal);

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    });
  </script>
